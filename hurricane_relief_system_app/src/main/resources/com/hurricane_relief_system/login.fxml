<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
    <children>
      <Button alignment="CENTER" mnemonicParsing="false" onAction="#switchToPrimary" prefHeight="37.0" prefWidth="64.0" text="Back" />
      <TextField fx:id="txt_username" promptText="Username" />
        <TextField fx:id="txt_password" promptText="Password" />
        <Label fx:id="lbl_error" text="Please sign in" />
        <Button fx:id="secondaryButton" text="Login" onAction="#btnLoginClicked" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
